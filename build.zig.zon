.{
    .name = .ventiws,
    .version = "1.0.0-rc.5",
    .fingerprint = 0x66c665792a0706f4, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // farbenbuilds/uWebZockets v2.0.5 plus the vendor-overlay packaging
        // fix and the function/data-section build flags used by the size pass.
        .uWebZockets = .{
            .url = "git+https://github.com/farbenbuilds/uWebZockets?ref=v2.0.5-ventiws.1#15ec728ac3a066a07e5e90a2364161021b463fa2",
            .hash = "uWebZockets-2.0.5-SD3SPM1tKgBrClxOl0zHBMAzBQ9GIc6RZU3O4sCLU8LD",
        },

        // farbenbuilds/zslay
        // The frame codec in `src/engine/codec` is a state machine over this
        // package's pure primitives, so the two paths onto the wire agree by
        // construction. Pinned to the artifact uWebZockets already resolves, so
        // the build graph carries one copy rather than two.
        .zslay = .{
            .url = "https://github.com/farbenbuilds/zslay/archive/refs/tags/v0.2.1.tar.gz",
            .hash = "zslay-0.2.1-OB-IfBl0AQCHCIVUH0AbAjErcCG_LNkaLp8Gz1BUXnoy",
        },

        // farbenbuilds/napi-zig: yuku-toolchain/napi-zig v0.3.1 plus the
        // npm-release fix that honors the requested optimize mode.
        .napi_zig = .{
            .url = "git+https://github.com/farbenbuilds/napi-zig?ref=v0.3.1-ventiws.1#038912638dbcaab61ba0bde912339200434de11a",
            .hash = "napi_zig-0.2.0-XRkY0XsYAgDIh9b-qjtT8olotHwNKi_6GSNKHwxLUR_d",
        },
        // ebiggers/libdeflate: the same revision the engine vendors, resolved directly so
        // the codec-only addon can compress without importing or linking the engine.
        .libdeflate = .{
            .url = "git+https://github.com/ebiggers/libdeflate#92e6a0db9fa848d742f9eb286c92afc60f2c3dda",
            .hash = "N-V-__8AAEaRCwCsYb_rSsH72Pb6DNFQLSjdRzTFOVsJWcoB",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
