.{
    .name = .ventiws,
    .version = "1.0.0-rc.5",
    .fingerprint = 0x66c665792a0706f4, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // farbenbuilds/uWebZockets v2.0.0 plus the vendor-overlay packaging
        // fix and the function/data-section build flags used by the size pass.
        .uWebZockets = .{
            .url = "git+https://github.com/farbenbuilds/uWebZockets#389558b46f8596599fa87d1b0b2c49e6788a591a",
            .hash = "uWebZockets-2.0.0-SD3SPPPFKQCVKGdvS6KdgvLfqmYJjxze0BwIwUFjC8Ae",
        },

        // farbenbuilds/zslay
        // The frame codec in `src/engine/codec` is a state machine over this
        // package's pure primitives, so the two paths onto the wire agree by
        // construction. Pinned to the artifact uWebZockets already resolves, so
        // the build graph carries one copy rather than two.
        .zslay = .{
            .url = "https://github.com/farbenbuilds/zslay/archive/refs/tags/v0.2.1.tar.gz",
            .hash = "zslay-0.2.1-OB-IfBl0AQCHCIVUH0AbAjErcCG_LNkaLp8Gz1BUXnoy",
        },

        // farbenbuilds/napi-zig: yuku-toolchain/napi-zig v0.3.1 plus the
        // npm-release fix that honors the requested optimize mode.
        .napi_zig = .{
            .url = "git+https://github.com/farbenbuilds/napi-zig?ref=fix/release-safe#038912638dbcaab61ba0bde912339200434de11a",
            .hash = "napi_zig-0.2.0-XRkY0XsYAgDIh9b-qjtT8olotHwNKi_6GSNKHwxLUR_d",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
