{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "integrator", "effect": "allow" }
  ],
  "agents": {
    "integrator": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "architect", "effect": "allow" },
        { "action": "subagent", "resource": "developer", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "compat-conformance-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "dod-performance-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "napi-bridge-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "refactor-auditor", "effect": "allow" },
        { "action": "subagent", "resource": "ts-api-architect", "effect": "allow" },
        { "action": "subagent", "resource": "zig-protocol-engineer", "effect": "allow" }
      ]
    }
  }
}
